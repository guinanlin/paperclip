DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false

# Required for agent heartbeat runs: server signs a short-lived JWT and injects it as PAPERCLIP_API_KEY.
# Without this, agents get 401 on /api/agents/me and cannot checkout, comment, or submit hires.
# Generate with: openssl rand -base64 32  (or run `pnpm paperclipai onboard`)
# PAPERCLIP_AGENT_JWT_SECRET=
